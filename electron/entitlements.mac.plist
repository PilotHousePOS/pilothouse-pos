<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  electron/entitlements.mac.plist

  Required entitlements for a hardened-runtime Electron app submitted to
  Apple notarization.  Electron needs the JIT and unsigned-executable-memory
  exceptions because it compiles JavaScript at runtime.
-->
<plist version="1.0">
  <dict>
    <!-- Allow just-in-time compilation (V8 engine) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow pages that are writable AND executable (required by Electron) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading dylibs that are not signed by Apple or the app -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
