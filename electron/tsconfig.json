{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "baseUrl": "..",
    "outDir": "../dist/electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "electron":         ["node_modules/electron/electron.d.ts"],
      "electron-updater": ["node_modules/electron-updater/out/main.d.ts"],
      "serialport":       ["node_modules/serialport/dist/index.d.ts"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "*.test.ts", "*.spec.ts"]
}
