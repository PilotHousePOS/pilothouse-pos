modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "gce"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 32959
externalPort = 8081

[[ports]]
localPort = 33051
externalPort = 3002

[[ports]]
localPort = 33365
externalPort = 4200

[[ports]]
localPort = 33575
externalPort = 3000

[[ports]]
localPort = 37029
externalPort = 3003

[[ports]]
localPort = 38143
externalPort = 8000

[[ports]]
localPort = 38697
externalPort = 8080

[[ports]]
localPort = 39375
externalPort = 3001

[[ports]]
localPort = 39913
externalPort = 6000

[[ports]]
localPort = 41671
externalPort = 5173

[[ports]]
localPort = 41869
externalPort = 8008

[[ports]]
localPort = 42737
externalPort = 8099

[[ports]]
localPort = 42967
externalPort = 5000

[[ports]]
localPort = 43863
externalPort = 6800

[[ports]]
localPort = 46735
externalPort = 9000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_log_in_with_replit:1.0.0", "sendgrid:1.0.0", "google-calendar:1.0.0"]

[userenv]

[userenv.shared]
TESTING_VITE_STRIPE_PUBLIC_KEY = "jumproof123"
TESTING_STRIPE_SECRET_KEY = "jumproof123"
