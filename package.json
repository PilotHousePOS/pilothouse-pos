  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "pretest": "tsx server/scripts/apply-missing-columns.ts",
    "test": "vitest run",
    "build:electron:main": "node scripts/write-electron-env.js && npx tsc -p electron/tsconfig.json",
    "build:electron:frontend": "vite build",
    "build:electron": "npm run build:electron:frontend && npm run build:electron:main && electron-builder",
    "dev:electron": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5000 && electron .\""
