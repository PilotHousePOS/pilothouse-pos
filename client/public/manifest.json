  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "protocol_handlers": [
    {
      "protocol": "web+pilothouse",
      "url": "/?action=%s"
    }
  ],
  "handle_links": "preferred",
  "scope_extensions": [],
